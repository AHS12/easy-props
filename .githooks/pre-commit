#!/bin/sh
# Quick checks on what is being committed. Skip with: git commit --no-verify
set -eu

cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)

go_files=$(printf '%s\n' "$staged" | grep '\.go$' || true)

if [ -n "$go_files" ]; then
	unformatted=$(gofmt -l $go_files)

	if [ -n "$unformatted" ]; then
		echo "These Go files need formatting. Run: gofmt -w <file>"
		echo "$unformatted"
		exit 1
	fi
fi

if printf '%s\n' "$staged" | grep -q '^frontend/'; then
	make typecheck lint
fi
